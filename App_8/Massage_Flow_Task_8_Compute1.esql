CREATE COMPUTE MODULE Massage_Flow_Task_8_Compute1
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        -- CALL CopyMessageHeaders();
        -- CALL CopyEntireMessage();


        SET OutputRoot.Properties = InputRoot.Properties;

        SET OutputRoot.HTTPRequestHeader."Content-Type" = 'text/xml; charset=utf-8';


        DECLARE soapenv NAMESPACE 'http://schemas.xmlsoap.org/soap/envelope/';
        CREATE FIELD OutputRoot.XMLNSC.soapenv:Envelope.soapenv:Body;


        DECLARE resultRef REFERENCE TO InputRoot.JSON.Data.*[1];
        DECLARE resultFieldName CHARACTER FIELDNAME(resultRef);
        DECLARE resultVal INT resultRef;


        DECLARE responseElementName CHARACTER REPLACE(resultFieldName, 'Result', 'Response');

        SET OutputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.(XMLNSC.Field)responseElementName.(XMLNSC.Field)resultFieldName = resultVal;

        RETURN TRUE;
    END;

    CREATE PROCEDURE CopyMessageHeaders() BEGIN
        DECLARE I INTEGER 1;
        DECLARE J INTEGER;
        SET J = CARDINALITY(InputRoot.*[]);
        WHILE I < J DO
            SET OutputRoot.*[I] = InputRoot.*[I];
            SET I = I + 1;
        END WHILE;
    END;

    CREATE PROCEDURE CopyEntireMessage() BEGIN
        SET OutputRoot = InputRoot;
    END;
END MODULE;